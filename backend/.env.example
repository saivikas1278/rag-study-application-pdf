# Google Gemini API Key and Model (Get key at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash


# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Allowed CORS Origins (comma-separated, Vite default is http://localhost:5173)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Vector Store and Embeddings Configuration
CHROMA_PERSIST_DIRECTORY=./chroma_db
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# PDF Upload Constraints
MAX_UPLOAD_SIZE_MB=15
